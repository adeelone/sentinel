FROM python:3.12-slim AS model
WORKDIR /app
COPY ml /app/ml
RUN pip install --no-cache-dir -e /app/ml
RUN python -m sentinel_ml.train --dataset synthetic --output-dir /app/artifacts

FROM python:3.12-slim
WORKDIR /app
COPY ml /app/ml
COPY backend /app/backend
COPY --from=model /app/artifacts /app/artifacts
RUN pip install --no-cache-dir -e /app/ml -e /app/backend
ENV MODEL_BUNDLE_PATH=/app/artifacts/model_bundle.joblib
WORKDIR /app/backend
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
