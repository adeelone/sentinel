{
  "name": "sentinel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.0",
    "@vitejs/plugin-react": "4.3.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "vite": "5.4.0",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@playwright/test": "1.46.0",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "husky": "9.1.4",
    "jsdom": "29.1.1",
    "lint-staged": "15.2.8",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "typescript-eslint": "7.18.0",
    "vitest": "2.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
